# Aerisence Environment Configuration Template
# Copy this file to .env for local overrides

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL in production, H2 in dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aerisence_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Telemetry Ingestion Thresholds
TEMP_MIN=-50.0
TEMP_MAX=60.0
PRESSURE_MIN=870.0
PRESSURE_MAX=1085.0
HUMIDITY_MIN=0.0
HUMIDITY_MAX=100.0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_ENABLE_3D=true
VITE_WS_ENDPOINT=ws://localhost:8080/ws
